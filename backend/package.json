{
  "name": "saba-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Saba marketplace API: Node.js, TypeScript, Express, MySQL",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "suspend-admin": "tsx scripts/suspend-admin.ts",
    "seed": "tsx scripts/seed.ts",
    "housekeeping": "tsx scripts/housekeeping.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "aws4fetch": "1.0.20",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "multer": "2.4.0",
    "mysql2": "3.24.4",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "swagger-ui-express": "5.0.1",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "24.19.0",
    "@types/swagger-ui-express": "4.1.8",
    "typescript": "7.0.2"
  }
}
