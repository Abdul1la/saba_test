# Copy to .env (which git ignores) and fill in. Only config.ts reads these.
# A password with characters like @ : / # in it must be URL-encoded in the addresses.

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# The development database, and the one the tests empty on every run (its name must end in _test).
DATABASE_URL=mysql://saba:CHANGE_ME@127.0.0.1:3307/saba
DATABASE_URL_TEST=mysql://saba:CHANGE_ME@127.0.0.1:3307/saba_test
DB_POOL_SIZE=10
# A managed database (production) needs TLS: the path to its CA certificate,
# downloaded from the database's page. Empty on a laptop.
DATABASE_CA_FILE=

# Two different random secrets, at least 32 characters each. Make one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
OTP_SECRET=

# Empty while developing: any http://localhost port may call. Required in production.
CORS_ORIGINS=

# Uploaded photos. disk: a folder (git ignores storage/), development only; this
# server serves them. s3: object storage (DigitalOcean Spaces), required in
# production, with the bucket's endpoint (https://fra1.digitaloceanspaces.com),
# its region (fra1), its name, an access key pair from the Spaces keys page, and
# MEDIA_BASE_URL = the bucket's CDN address (https://<bucket>.fra1.cdn.digitaloceanspaces.com).
MEDIA_STORAGE=disk
MEDIA_DIR=storage
MEDIA_BASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SMS codes: log (the server's log; development only) or otpiq (required in production).
# A dev key (sk_dev_...) makes OTPIQ deliver only to the test number set in its dashboard.
# OTPIQ_CHANNEL: auto, sms, whatsapp, telegram, whatsapp-sms, telegram-sms, whatsapp-telegram-sms.
SMS_PROVIDER=log
OTPIQ_API_KEY=
OTPIQ_CHANNEL=auto
OTPIQ_SENDER_ID=
# on (default) or off: off lets sign-up through without an SMS code, the account kept
# "number not checked"; password reset still sends its code. Back on: no app release needed.
PHONE_VERIFICATION=on

# Push notifications (S10): log (what would be sent goes to the server's log;
# development only) or fcm (Firebase). For fcm, FCM_SERVICE_ACCOUNT_FILE is the
# path to the service-account JSON downloaded from the Firebase console
# (Project settings > Service accounts); keep it out of git. Missing or
# unreadable, the server still starts and logs that push is off.
PUSH_PROVIDER=log
FCM_SERVICE_ACCOUNT_FILE=
# On a host with no files of its own (Railway): that file's contents instead,
# as its JSON or in base64. Used only when FCM_SERVICE_ACCOUNT_FILE is empty.
FCM_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=info
DOCS_ENABLED=true
# How many proxies stand in front of the server. Required in production:
# 1 behind one HTTPS proxy (Caddy on the same machine), false when it faces
# the internet itself. Unset behind a proxy, every shopper shares the proxy's
# address and one set of SMS and sign-in limits.
TRUST_PROXY=false
